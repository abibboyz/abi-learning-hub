 "sql": [
  "CREATE TABLE \"lab_bloggers\" (\n  \"id\" SERIAL NOT NULL,\n  \"handle\" TEXT NOT NULL,\n  CONSTRAINT \"lab_bloggers_pkey\" PRIMARY KEY (\"id\")\n);",
  "CREATE TABLE \"lab_posts\" (\n  \"id\" SERIAL NOT NULL,\n  \"title\" TEXT NOT NULL,\n  \"blogger_id\" INTEGER NOT NULL,\n  CONSTRAINT \"lab_posts_pkey\" PRIMARY KEY (\"id\")\n);",
  "CREATE TABLE \"lab_tags\" (\n  \"id\" SERIAL NOT NULL,\n  \"label\" TEXT NOT NULL,\n  CONSTRAINT \"lab_tags_pkey\" PRIMARY KEY (\"id\")\n);",
  "CREATE TABLE \"lab_post_tags\" (\n  \"post_id\" INTEGER NOT NULL,\n  \"tag_id\" INTEGER NOT NULL,\n  CONSTRAINT \"lab_post_tags_pkey\" PRIMARY KEY (\"post_id\", \"tag_id\")\n);",
  "CREATE UNIQUE INDEX \"lab_bloggers_handle_key\" ON \"lab_bloggers\" (\"handle\");",
  "ALTER TABLE \"lab_posts\" ADD CONSTRAINT \"lab_posts_blogger_id_fkey\" FOREIGN KEY (\"blogger_id\") REFERENCES \"lab_bloggers\" (\"id\");",
  "CREATE UNIQUE INDEX \"lab_tags_label_key\" ON \"lab_tags\" (\"label\");",
  "ALTER TABLE \"lab_post_tags\" ADD CONSTRAINT \"lab_post_tags_post_id_fkey\" FOREIGN KEY (\"post_id\") REFERENCES \"lab_posts\" (\"id\") ON DELETE CASCADE;",
  "ALTER TABLE \"lab_post_tags\" ADD CONSTRAINT \"lab_post_tags_tag_id_fkey\" FOREIGN KEY (\"tag_id\") REFERENCES \"lab_tags\" (\"id\") ON DELETE CASCADE;"
