# abi-learning-hub — copy to .env and adjust as needed
POSTGRES_USER=hub
POSTGRES_PASSWORD=hub_secret
POSTGRES_DB=learning_hub
POSTGRES_PORT=5432

# Shared by APIs (compose overrides host to "postgres")
DATABASE_URL=postgresql+psycopg://hub:hub_secret@localhost:5432/learning_hub
DATABASE_URL_NODE=postgresql://hub:hub_secret@localhost:5432/learning_hub

# Service ports (host)
PYTHON_API_PORT=8000
NODE_API_PORT=8001
WEB_PORT=3000

# Next.js public URLs (browser → APIs)
NEXT_PUBLIC_PYTHON_API_URL=http://localhost:8000
NEXT_PUBLIC_NODE_API_URL=http://localhost:8001
