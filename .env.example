# abi-learning-hub — copy to .env and adjust as needed
# One platform: docker compose up --build → http://localhost:3000
# Track selection happens in the web UI only.

POSTGRES_USER=hub
POSTGRES_PASSWORD=hub_secret
POSTGRES_DB=learning_hub
POSTGRES_PORT=5432

# Used by local (non-Compose) API processes only
DATABASE_URL=postgresql+psycopg://hub:hub_secret@localhost:5432/learning_hub
DATABASE_URL_NODE=postgresql://hub:hub_secret@localhost:5432/learning_hub

# Public learner entry (Compose publishes only this)
WEB_PORT=3000

# Optional: local-dev BFF upstreams when APIs run on the host
# (Compose sets these automatically to http://api-python:8000 / http://api-node:8001)
# PYTHON_API_INTERNAL=http://localhost:8000
# NODE_API_INTERNAL=http://localhost:8001
